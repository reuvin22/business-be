# Copy this file to .env and change the values if needed.

# Firebase service account key (Firebase Console > Project settings > Service accounts > Generate new private key).
# Never commit this file.
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
# ...or paste the whole key file contents here instead (handy on hosting platforms):
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}

# Firebase Realtime Database (live chat): Firebase Console > Realtime Database > the address at the top
FIREBASE_DATABASE_URL=https://my-business-5bcad-default-rtdb.asia-southeast1.firebasedatabase.app

# Frontend URLs allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Redis cache (e.g. from Redis Cloud). Leave empty to run without a cache.
REDIS_URL=

# Cloudflare R2 (image uploads). Leave empty to turn uploads off.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Xendit (online payments in the selling app). Leave empty to sell with cash only.
# Dashboard > Settings > Developers: the secret API key, and the webhook verification token.
# Webhook URL to set there: https://<your-api>/api/v1/webhooks/xendit
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Platform admins (comma-separated emails): they review verifications and manage categories
ADMIN_EMAILS=
